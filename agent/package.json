{
  "name": "bedcoder",
  "version": "0.1.11",
  "description": "Headless daemon to drive Claude Code from your phone — pair, then relay the session end-to-end encrypted.",
  "keywords": [
    "claude",
    "claude-code",
    "ai",
    "agent",
    "remote",
    "cli",
    "headless"
  ],
  "homepage": "https://bedcoder.org",
  "author": "Pu Shi",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "bin": {
    "bedcoder": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "tsx src/index.ts",
    "build": "tsup",
    "prepublishOnly": "pnpm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.167",
    "@msgpack/msgpack": "^2.8.0",
    "diff": "^9.0.0",
    "qrcode": "^1.5.4",
    "tweetnacl": "^1.0.3",
    "ws": "^8.18.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@bedcoder/protocol": "workspace:*",
    "@types/qrcode": "^1.5.5",
    "@types/ws": "^8.5.13",
    "tsup": "^8.3.5"
  }
}
